{
  "name": "gaia-protocol",
  "version": "0.0.0",
  "private": false,
  "license": "MIT",
  "author": "Nilklops Inc.",
  "description": "45.4 億年の惑星シミュレータ。気候・炭素循環・水循環・プレートテクトニクス・海洋・生命を結合して回す",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gpu-verify": "vite-node scripts/gpu-verify.ts",
    "smoke": "vite-node scripts/smoke.ts",
    "audit": "vite-node scripts/audit.ts",
    "build:deploy": "npm run build && vite-node scripts/prune-dist.ts",
    "deploy": "npm run build:deploy && npx wrangler pages deploy dist --project-name=gaia-protocol"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.72",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
